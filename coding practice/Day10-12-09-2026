
- name: Setup Docker container for Multiple Apps
  hosts: all
  become: yes
  tasks:
    - name: Pull web app image
      docker image:
        name: my-web-app
        source: pull

    - name: Pull Database App Image
      docker image:
         name: my-database-app
         source: pull
 
    - name: Run web app container
      docker_container:
         name: web-app
         image: my-web-app
         state: started 
         published_ports:
           - "8080:80"

    - name: Run Database App container
      docker_container:
         name: database-app
         image: my-database-app
         state: Started
         published_ports:
           - "3306:3306"

🔹 Terraform — VPC with Private and Public Subnets
 resource "aws_vpc" "main" {
   cidr_block = "10.0.0.0/16"
 }

 resource "aws_subnet" "public" {
   vpc_id               = aws_vpc.main.id
   cidr_block           = "10.0.1.0/16"
   availablity_zone     = "us-east-1a"
   map_public_ip_on_launch = true
}

 resource "aws_subnet" "private" {
   vpc_id                    = aws_vpc_main.id
   cidr_block                = "10.0.2.0/16"
   availablity_zone          = "us-east-1b"
}

🔹 Kubernetes — Deploying StatefulSet
 apiversion: apps/v1
 kind: StatefulSet
 metadata:
     name: Pathnex-db
 spec: 
   serviceName: "Pathnex-db"
   replicas: 3
   selector:
     matchlabels:
        app: Pathnex-db
   template:
     metadata:
       labels:
          app: pathnex-db
   spec:
    containers:
      - name: db
        image: mysql:5.7
        volumeMounts:
           -mountPath: /var/lib/mysql
            name: mysql-storage
  volumeClaimtemplates:
    - metadata:
        name: mysql-storage
      spec:
        accessModes: ["readWriteonce"]
        resources:
          requests:
           storage: 1Gi
🔹 Jenkinsfile — Build and Deploy to Kubernetes
 pipeline {
     agent any
     environment {
        IMAGE_NAME = 'pathnex-web-app'
     }
      stages {
          stage ('Build Docker Image') {
              steps {
                  script {
                      docker.build("${env.IMAGE_NMAE}")
                    }
                 }
             }
          stage('Push Docker Image') {
              steps {
                  script {
                    docker.withRegistry('https://docker.io', 'docker-credentials') {
                      docker.image(${env.IMAGE_NAME}").push('latest')
                    }
                 }
              }
         }
          stage('Deploy to Kubernetes') {
               steps {
                    script {
                         sh ' kubectl apply -f deployment.yaml'
                    }
                }
             }
          }
       }
 
